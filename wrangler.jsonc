// Zombuild / weaselwonder.com. Pushing to main deploys via Cloudflare Workers Builds.
// Secrets (HOST_PASSWORD, DEPLOY_TOKEN) live in Cloudflare only, never in this repo.
{
  "name": "weaselwonder",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [ { "name": "ROOM", "class_name": "Room" } ] },
  "kv_namespaces": [ { "binding": "SITE", "id": "b6e5bf1566df45d5a85ce238d53761ab" } ]
}
